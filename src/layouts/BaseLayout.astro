---
import ComingSoonGate from "../components/ComingSoonGate.astro";
import "../styles/tokens.css";
import "../styles/base.css";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: any;
}

import { siteConfig } from "../config";
const { title, description, canonical, ogImage, noindex, jsonLd } = Astro.props;
const shouldNoIndex = noindex || siteConfig.comingSoon;
const showComingSoon = siteConfig.comingSoon && !import.meta.env.DEV;
---
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&display=swap" rel="stylesheet" />
    {shouldNoIndex && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {jsonLd && (Array.isArray(jsonLd) 
      ? jsonLd.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <ComingSoonGate />
    <div id="site-content" inert={showComingSoon} aria-hidden={showComingSoon ? 'true' : undefined}>
      <slot />
    </div>
  </body>
</html>
