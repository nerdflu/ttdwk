---
import CityShell from '../../components/CityShell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DiscoveryRow from '../../components/DiscoveryRow.astro';
import { getCities, getCityBySlug, getAvailableCategoriesForCity, getPlacesForCity, getEventsForCity, getIdeasForCity, getCategoryBySlug } from '../../lib/data';
import { generateCategoryHeading, generateCategorySeoTitle } from '../../lib/seo';
import { collectionPageSchema, itemListSchema, breadcrumbSchema } from '../../lib/schema';
import { countLabel } from '../../lib/presentation';

export function getStaticPaths() {
  const paths: { params: { city: string, category: string } }[] = [];
  
  getCities().forEach(city => {
    const cats = getAvailableCategoriesForCity(city.slug);
    cats.forEach(cat => {
      paths.push({
        params: { city: city.slug, category: cat.slug }
      });
    });
  });
  
  return paths;
}

const { city, category } = Astro.params;
const cityData = getCityBySlug(city as string);
const catData = getCategoryBySlug(category as string);
const title = generateCategorySeoTitle(city as string, category as string);
const description = catData?.description || title;
const heading = generateCategoryHeading(city as string, category as string);

const places = getPlacesForCity(city as string).filter((p: any) => p.categories?.includes(category as string));
const events = getEventsForCity(city as string).filter((e: any) => e.categories?.includes(category as string));
const ideas = getIdeasForCity(city as string).filter((i: any) => i.categories?.includes(category as string));
const total = places.length + ideas.length + events.length;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: cityData?.title || (city as string), href: '/' + city + '/' },
  { label: catData?.title || (category as string) }
];

const visibleItems = [...events, ...places, ...ideas].map(item => {
  let subpath = 'places';
  if (item.start_date) subpath = 'events';
  else if (item.steps) subpath = 'ideas';
  
  let itemUrl = '/' + city + '/' + subpath + '/' + item.slug + '/';
  if (subpath === 'events') {
    itemUrl = item.booking_url || item.source_url || '';
  } else if (subpath === 'places' && item.has_page !== 'yes') {
    itemUrl = item.affiliate_url || item.booking_url || item.website || item.maps_url || '';
  }
  
  return {
    name: item.title,
    url: itemUrl
  };
});

const jsonLd = [
  collectionPageSchema(title, description, '/' + city + '/' + category + '/'),
  itemListSchema(visibleItems),
  breadcrumbSchema(breadcrumbs)
];

---
<CityShell citySlug={city as string} title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbs} />

  <header class="page-header">
    <h1>{heading}</h1>
    {catData?.description && <p class="lede">{catData.description}</p>}
    <p class="count">{countLabel(places.length, ideas.length, events.length)}</p>
  </header>
  
  {total === 0 ? (
    <p class="empty">
      Nothing in this collection yet.
      <a href={'/' + city + '/'}>See more things to do {cityData?.preposition} {cityData?.title || city}</a>
    </p>
  ) : (
    <div class="discovery-list">
      {places.map((place: any) => (
        <DiscoveryRow kind="place" item={place} citySlug={city as string} categoryLabel={catData?.title} />
      ))}
      {ideas.map((idea: any) => (
        <DiscoveryRow kind="idea" item={idea} citySlug={city as string} categoryLabel={catData?.title} />
      ))}
      {events.map((event: any) => (
        <DiscoveryRow kind="event" item={event} citySlug={city as string} categoryLabel={catData?.title} />
      ))}
    </div>
  )}

  {events.length > 0 && (
    <p class="more-events">
      <a href={'/' + city + '/events/'}>All upcoming events in {cityData?.title || city}</a>
    </p>
  )}

  <style>
    .page-header {
      margin-bottom: var(--space-7);
    }

    h1 {
      margin: 0;
      max-width: 16ch;
      font-size: var(--font-size-h2);
      font-weight: var(--font-weight-semibold);
      line-height: var(--font-leading-heading);
      letter-spacing: var(--font-tracking-tight);
    }

    .lede {
      margin: var(--space-4) 0 0;
      max-width: 42rem;
      color: var(--color-text-secondary);
      font-size: var(--font-size-body-large);
    }

    .count {
      margin: var(--space-3) 0 0;
      color: var(--color-text-secondary);
      font-size: var(--font-size-small);
    }

    .empty {
      margin: 0;
      padding: var(--space-6);
      background: var(--color-surface-canvas);
      border-radius: var(--radius-large);
      box-shadow: var(--shadow-keyline);
    }

    .empty a {
      display: inline-block;
      margin-top: var(--space-3);
    }

    .more-events {
      margin: var(--space-6) 0 0;
    }

    .more-events a {
      font-weight: var(--font-weight-semibold);
      text-decoration: none;
    }

    .more-events a:hover {
      text-decoration: underline;
      text-underline-offset: 0.16em;
    }
  </style>
</CityShell>
