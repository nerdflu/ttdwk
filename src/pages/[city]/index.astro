---
import CityShell from '../../components/CityShell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCities, getCityBySlug, getAvailableCategoriesForCity, getUpcomingEventsForCity, getWeekendEventsForCity, getIdeasForCity, getGuidesForCity } from '../../lib/data';
import { generateCityHeading, generateCitySeoTitle } from '../../lib/seo';
import { collectionPageSchema, itemListSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return getCities().map(city => ({
    params: { city: city.slug }
  }));
}

const { city } = Astro.params;
const cityData = getCityBySlug(city as string);
const title = generateCitySeoTitle(city as string);
const heading = generateCityHeading(city as string);
const description = cityData?.description || title;

const categories = getAvailableCategoriesForCity(city as string);
const upcomingEvents = getUpcomingEventsForCity(city as string);
const weekendEvents = getWeekendEventsForCity(city as string);
const topIdeas = getIdeasForCity(city as string).slice(0, 4);
const topGuides = getGuidesForCity(city as string).slice(0, 4);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: cityData?.title || (city as string) }
];

const visibleItems = [...topIdeas, ...topGuides].map(item => {
  const subpath = item.steps ? 'ideas' : 'guides';
  return {
    name: item.title,
    url: '/' + city + '/' + subpath + '/' + item.slug + '/'
  };
});

const jsonLd = [
  collectionPageSchema(title, description, '/' + city + '/'),
  itemListSchema(visibleItems),
  breadcrumbSchema(breadcrumbs)
];
---
<CityShell citySlug={city as string} title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbs} />

  <h1>{heading}</h1>
  {cityData?.description && <p class='intro'>{cityData.description}</p>}
  
  {upcomingEvents.length > 0 && (
    <section class='home-module'>
      <h2>What's on for kids</h2>
      <p>Fresh things happening around {cityData?.title || city}.</p>
      <ul class='gateway-links'>
        {weekendEvents.length > 0 && <li><a href={'/' + city + '/events/this-weekend/'}>This weekend</a></li>}
        <li><a href={'/' + city + '/events/'}>All upcoming events</a></li>
      </ul>
    </section>
  )}

  {categories.length > 0 && (
    <section class='home-module'>
      <h2>Explore family activities by mood</h2>
      <ul class='gateway-links'>
        {categories.map((c: any) => (
          <li><a href={'/' + city + '/' + c.slug + '/'}>{c.title}</a></li>
        ))}
      </ul>
    </section>
  )}
  
  {topIdeas.length > 0 && (
    <section class='home-module'>
      <h2>Easy family adventure ideas</h2>
      <ul>
        {topIdeas.map((i: any) => (
          <li><a href={'/' + city + '/ideas/' + i.slug + '/'}>{i.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  {topGuides.length > 0 && (
    <section class='home-module'>
      <h2>{cityData?.title || city} family guides</h2>
      <ul>
        {topGuides.map((g: any) => (
          <li><a href={'/' + city + '/guides/' + g.slug + '/'}>{g.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</CityShell>

<style>
  .home-module {
    margin-top: 40px;
  }
  .gateway-links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }
  .gateway-links li a {
    display: inline-block;
    padding: 10px 20px;
    background: #f4f4f4;
    border-radius: 8px;
    text-decoration: none;
    color: #333;
    font-weight: 500;
  }
  .gateway-links li a:hover {
    background: #e0e0e0;
  }
</style>
