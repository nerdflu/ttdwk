---
import CityShell from '../../../components/CityShell.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EventCollection from '../../../components/EventCollection.astro';
import { getCities, getUpcomingEventsForCity, getCityBySlug } from '../../../lib/data';
import { generateEventsSeoTitle } from '../../../lib/seo';
import { collectionPageSchema, itemListSchema, breadcrumbSchema } from '../../../lib/schema';

export function getStaticPaths() {
  const paths: { params: { city: string } }[] = [];
  getCities().forEach(city => {
    if (getUpcomingEventsForCity(city.slug).length > 0) {
      paths.push({ params: { city: city.slug } });
    }
  });
  return paths;
}

const { city } = Astro.params;
const cityData = getCityBySlug(city as string);
const allEvents = getUpcomingEventsForCity(city as string);
const cityName = cityData?.title || (city as string);
const cityLocation = cityData ? `${cityData.preposition} ${cityName}` : cityName;

const title = generateEventsSeoTitle(city as string);
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: cityName, href: '/' + city + '/' },
  { label: 'Events' }
];

const visibleItems = allEvents.map((item: any) => ({
  name: item.title,
  url: item.booking_url || item.source_url || ''
}));

const jsonLd = [
  collectionPageSchema(title, 'Find the best upcoming family events.', '/' + city + '/events/'),
  itemListSchema(visibleItems),
  breadcrumbSchema(breadcrumbs)
];
---
<CityShell citySlug={city as string} title={title} description='Find the best upcoming family events.' jsonLd={jsonLd} variant="events">
  <Breadcrumbs items={breadcrumbs} />
  <EventCollection
    events={allEvents}
    cityLocation={cityLocation}
    scope="all"
    allHref={`/${city}/events/`}
    weekendHref={`/${city}/events/this-weekend/`}
  />
</CityShell>
