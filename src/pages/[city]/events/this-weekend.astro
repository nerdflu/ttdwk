---
import CityShell from '../../../components/CityShell.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EventCollection from '../../../components/EventCollection.astro';
import { getCities, getWeekendEventsForCity, getCityBySlug } from '../../../lib/data';
import { generateWeekendTitle } from '../../../lib/seo';
import { collectionPageSchema, itemListSchema, breadcrumbSchema } from '../../../lib/schema';

export function getStaticPaths() {
  const paths: { params: { city: string } }[] = [];
  getCities().forEach(city => {
    if (getWeekendEventsForCity(city.slug).length > 0) {
      paths.push({ params: { city: city.slug } });
    }
  });
  return paths;
}

const { city } = Astro.params;
const cityData = getCityBySlug(city as string);
const events = getWeekendEventsForCity(city as string);
const cityName = cityData?.title || (city as string);
const cityLocation = cityData ? `${cityData.preposition} ${cityName}` : cityName;
const title = generateWeekendTitle(city as string);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: cityName, href: `/${city}/` },
  { label: 'Events', href: `/${city}/events/` },
  { label: 'This weekend' }
];

const visibleItems = events.map(item => ({
  name: item.title,
  url: item.booking_url || item.source_url || ''
}));

const jsonLd = [
  collectionPageSchema(title, "What's on this weekend for kids.", `/${city}/events/this-weekend/`),
  itemListSchema(visibleItems),
  breadcrumbSchema(breadcrumbs)
];
---
<CityShell citySlug={city as string} title={title} description="What's on this weekend for kids." jsonLd={jsonLd} variant="events">
  <Breadcrumbs items={breadcrumbs} />
  <EventCollection
    events={events}
    cityLocation={cityLocation}
    scope="weekend"
    allHref={`/${city}/events/`}
    weekendHref={`/${city}/events/this-weekend/`}
  />
</CityShell>
