---
import ExternalLink from '../../../components/ExternalLink.astro';
import CityShell from '../../../components/CityShell.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCities, getWeekendEventsForCity, getCityBySlug } from '../../../lib/data';
import { collectionPageSchema, itemListSchema, breadcrumbSchema } from '../../../lib/schema';

export function getStaticPaths() {
  const paths: { params: { city: string } }[] = [];
  getCities().forEach(city => {
    if (getWeekendEventsForCity(city.slug).length > 0) {
      paths.push({ params: { city: city.slug } });
    }
  });
  return paths;
}

const { city } = Astro.params;
const cityData = getCityBySlug(city as string);
const events = getWeekendEventsForCity(city as string);
const title = `Things to do with kids in ${cityData?.title || city} this weekend`;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: cityData?.title || (city as string), href: `/${city}/` },
  { label: 'Events', href: `/${city}/events/` },
  { label: 'This weekend' }
];

const visibleItems = events.map(item => ({
  name: item.title,
  url: `/${city}/events/${item.slug}/`
}));

const jsonLd = [
  collectionPageSchema(title, "What's on this weekend for kids.", `/${city}/events/this-weekend/`),
  itemListSchema(visibleItems),
  breadcrumbSchema(breadcrumbs)
];
---
<CityShell citySlug={city as string} title={title} description="What's on this weekend for kids." jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbs} />
  <h1>This Weekend</h1>
  <p class='disclaimer' style='font-style: italic; color: #666; margin-bottom: 20px;'>Event details can change. Check the official source before you go.</p>
  
  {events.length > 0 ? (
    <div class='events-list'>
      {events.map((e: any) => {
        const link = e.booking_url || e.source_url;
        return (
          <div class='event-card' style='border: 1px solid #ddd; padding: 15px; margin-bottom: 20px; border-radius: 8px;'>
            <h2 style='margin-top: 0; margin-bottom: 5px;'>{e.title}</h2>
            <p class='meta' style='color: #666; margin-bottom: 10px;'>
              <strong>{e.start_date}</strong> {e.start_time ? 'at ' + e.start_time : ''}
              {e.venue ? ' - ' + e.venue : (e.suburb ? ' - ' + e.suburb : '')}
            </p>
            {e.summary && <p class='summary' style='margin-bottom: 15px;'>{e.summary}</p>}
            {link && <ExternalLink href={link} class='btn' style='display: inline-block; padding: 8px 16px; background: #007bff; color: white; text-decoration: none; border-radius: 4px;'>Official details</ExternalLink>}
          </div>
        );
      })}
    </div>
  ) : (
    <p>No events found for this weekend.</p>
  )}
</CityShell>
