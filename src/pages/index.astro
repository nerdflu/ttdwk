---
import CityShell from '../components/CityShell.astro';
import { websiteSchema, organizationSchema } from '../lib/schema';
import { getCities } from '../lib/data';

const cities = getCities();
const jsonLd = [websiteSchema(), organizationSchema()];
---
<CityShell title="Things to do with kids in Australia" description="Discover the best family activities, events, and places to go with kids." jsonLd={jsonLd}>
  <div style="padding: 20px;">
    <h1>Things to do with kids</h1>
    
    <section>
      <h2>Browse by City</h2>
      <ul>
        {cities.map((city: any) => (
          <li><a href={"/" + city.slug + "/"}>{city.title}</a></li>
        ))}
      </ul>
    </section>
  </div>
</CityShell>
