---
import { siteConfig } from '../config';
const showComingSoon = siteConfig.comingSoon && !import.meta.env.DEV;
---

{showComingSoon && (
  <div id="coming-soon-gate" class="coming-soon-overlay" role="dialog" aria-modal="true" aria-labelledby="coming-soon-title" tabindex="-1">
    <div class="coming-soon-content">
      <p class="brand">Things To Do With Kids</p>
      <h1 id="coming-soon-title">A family guide for Australian cities, almost ready.</h1>
      <p>We're finishing the first cities. Check back soon for places, ideas and weekends worth leaving the house for.</p>
    </div>
  </div>

  <script is:inline>
    window.disableComingSoon = function() {
      localStorage.setItem('bypass_coming_soon', 'true');
      const gate = document.getElementById('coming-soon-gate');
      const content = document.getElementById('site-content');
      if (gate) gate.remove();
      if (content) {
        content.removeAttribute('inert');
        content.removeAttribute('aria-hidden');
      }
      return 'Coming soon disabled!';
    };

    window.enableComingSoon = function() {
      localStorage.removeItem('bypass_coming_soon');
      window.location.reload();
      return 'Coming soon enabled!';
    };

    if (localStorage.getItem('bypass_coming_soon') === 'true') {
      const gate = document.getElementById('coming-soon-gate');
      const content = document.getElementById('site-content');
      if (gate) gate.remove();
      if (content) {
        content.removeAttribute('inert');
        content.removeAttribute('aria-hidden');
      }
    } else {
      document.getElementById('coming-soon-gate')?.focus();
    }
  </script>

  <style>
    .coming-soon-overlay {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: grid;
      place-items: center;
      padding: var(--gutter);
      background: var(--color-surface-warm);
      color: var(--color-text-primary);
    }
    .coming-soon-content {
      max-width: 28rem;
      text-align: left;
    }
    .brand {
      margin: 0 0 var(--space-5);
      font-size: var(--font-size-small);
      font-weight: var(--font-weight-semibold);
      letter-spacing: var(--font-tracking-label);
      text-transform: uppercase;
    }
    .coming-soon-content h1 {
      margin: 0 0 var(--space-4);
      font-size: var(--font-size-h3);
      font-weight: var(--font-weight-semibold);
      line-height: var(--font-leading-heading);
      letter-spacing: var(--font-tracking-tight);
    }
    .coming-soon-content p {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--font-size-body-large);
    }
  </style>
)}
