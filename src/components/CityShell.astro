---
import BaseLayout from '../layouts/BaseLayout.astro';
import CityContextNav from './CityContextNav.astro';
import { getCityBySlug, getCities, getNearbyCities } from '../lib/data';

export interface Props {
  citySlug?: string;
  title: string;
  description: string;
  jsonLd?: any;
  variant?: 'default' | 'events';
}

const { citySlug, title, description, jsonLd, variant = 'default' } = Astro.props;
const city = citySlug ? getCityBySlug(citySlug) : null;
const allCities = getCities();
const nearbyCities = citySlug ? getNearbyCities(citySlug) : [];
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class:list={['city-shell', variant === 'events' && 'events-shell']}>
    <aside class="left-rail">
      <a class="brand brand-mobile" href={city ? `/${city.slug}/` : '/'} id="brand-link">Things To Do With Kids</a>
      <a class="brand-tile" href={city ? `/${city.slug}/` : '/'} aria-label="Things To Do With Kids home">
        <span>Things</span>
        <span>to do</span>
        <span>with kids</span>
      </a>
      <div class="city-picker">
        <a href={city ? `/${city.slug}/` : '/'} id="city-selector-link" class="city-name-link">
          <strong id="city-selector-label">{city?.title || 'Choose a city'}</strong>
        </a>
        <details class="city-dropdown">
          <summary aria-label="Choose another city">
            <span class="visually-hidden">Choose another city</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20">
              <path d="m5 7.5 5 5 5-5" />
            </svg>
          </summary>
          <ul class="city-dropdown-list">
            {allCities.map((c: any) => (
              <li><a href={`/${c.slug}/`} class="city-link" data-slug={c.slug} data-title={c.title}>{c.title}</a></li>
            ))}
            <li><a href="/">Browse all cities</a></li>
          </ul>
        </details>
      </div>
      <CityContextNav citySlug={citySlug} currentPath={currentPath} />
      <p class="suggest-note">Know a good outing? Suggestions open at launch.</p>
    </aside>
    
    <main class="center-column" id="main">
      <slot />
    </main>
    
    <aside class="right-rail">
      <div class="weekend-digest">
        <h2>Make the next outing easy</h2>
        <p>A short, useful list of local ideas, delivered when the public site opens.</p>
        <span class="digest-status">Newsletter form coming next</span>
      </div>
      {nearbyCities.length > 0 && (
        <div class="nearby-regions">
          <h2>Nearby</h2>
          <ul>
            {nearbyCities.map((c: any) => (
              <li><a href={`/${c.slug}/`}>{c.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<script define:vars={{ currentCitySlug: citySlug }}>
  (function() {
    if (currentCitySlug) {
      localStorage.setItem('ttdwk:selectedCity', currentCitySlug);
    } else {
      const savedSlug = localStorage.getItem('ttdwk:selectedCity');
      if (savedSlug) {
        const link = document.querySelector('a.city-link[data-slug="' + savedSlug + '"]');
        if (link) {
          const title = link.getAttribute('data-title');
          const label = document.getElementById('city-selector-label');
          const headerLink = document.getElementById('city-selector-link');
          if (label && title) label.innerText = title;
          if (headerLink) headerLink.setAttribute('href', '/' + savedSlug + '/');
          const brandLink = document.getElementById('brand-link');
          if (brandLink) brandLink.setAttribute('href', '/' + savedSlug + '/');
        }
      }
    }

    document.querySelectorAll('.city-link').forEach(link => {
      link.addEventListener('click', (e) => {
        const slug = e.currentTarget.dataset.slug;
        if (slug) localStorage.setItem('ttdwk:selectedCity', slug);
      });
    });
    
    document.addEventListener('click', function(event) {
      const details = document.querySelector('.city-dropdown');
      if (details && details.hasAttribute('open') && !details.contains(event.target)) {
        details.removeAttribute('open');
      }
    });
  })();
</script>

<style>
  .city-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    width: min(calc(100% - 2 * var(--gutter)), var(--layout-max));
    margin: 0 auto;
    padding: var(--space-5) 0 var(--space-10);
  }

  .left-rail,
  .right-rail {
    min-width: 0;
  }

  .brand-mobile {
    display: inline-block;
    margin-bottom: var(--space-3);
    color: var(--color-text-primary);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--font-tracking-normal);
    text-decoration: none;
  }

  .brand-tile {
    display: none;
  }

  .city-picker {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    position: relative;
    width: fit-content;
    margin-bottom: var(--space-4);
  }

  .city-name-link {
    color: inherit;
    font-size: var(--font-size-h4);
    letter-spacing: var(--font-tracking-tight);
    text-decoration: none;
  }

  .city-name-link:hover,
  .brand-mobile:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .city-dropdown summary {
    justify-content: center;
    width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    list-style: none;
    color: var(--color-text-primary);
    border-radius: var(--radius-pill);
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  .city-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .city-dropdown summary:hover {
    background: var(--color-surface-canvas);
  }

  .city-dropdown summary svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--motion-standard) var(--ease-out);
  }

  .city-dropdown[open] summary svg {
    transform: rotate(180deg);
  }

  .city-dropdown-list {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 20;
    min-width: 14rem;
    margin: 0;
    padding: var(--space-3);
    list-style: none;
    background: var(--color-surface-canvas);
    border-radius: var(--radius-medium);
    box-shadow: var(--shadow-soft), var(--shadow-keyline);
  }

  .city-dropdown-list li + li {
    margin-top: var(--space-2);
  }

  .city-dropdown-list li:last-child {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .city-dropdown-list a {
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .city-dropdown-list a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .suggest-note {
    margin: var(--space-5) 0 0;
    max-width: 28ch;
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
  }

  .center-column {
    min-width: 0;
  }

  .right-rail {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .right-rail h2,
  .nearby-regions h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--font-tracking-normal);
  }

  .weekend-digest h2 {
    max-width: 17ch;
    margin-bottom: var(--space-3);
    font-size: var(--font-size-h4);
    letter-spacing: var(--font-tracking-tight);
  }

  .weekend-digest,
  .nearby-regions {
    padding: var(--space-5);
    background: var(--color-surface-canvas);
    border-radius: var(--radius-large);
    box-shadow: var(--shadow-keyline);
  }

  .weekend-digest p,
  .nearby-regions a {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
  }

  .digest-status {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--color-text-primary);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-semibold);
  }

  .nearby-regions ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nearby-regions li + li {
    margin-top: var(--space-2);
  }

  .nearby-regions a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nearby-regions a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  @media (min-width: 64rem) {
    .city-shell {
      grid-template-columns: 14.5rem minmax(0, 1fr) 15rem;
      grid-template-areas: "rail main aside";
      align-items: start;
      column-gap: var(--space-8);
    }

    .left-rail { grid-area: rail; position: sticky; top: var(--space-5); }
    .center-column { grid-area: main; }
    .right-rail { grid-area: aside; }

    .brand-mobile {
      display: none;
    }

    .brand-tile {
      display: flex;
      width: min(100%, 10.75rem);
      aspect-ratio: 1;
      flex-direction: column;
      justify-content: flex-end;
      margin-bottom: var(--space-3);
      padding: var(--space-5);
      overflow: hidden;
      background: var(--color-accent-sky);
      border-radius: var(--radius-large);
      color: var(--color-text-primary);
      font-size: clamp(1.25rem, 1rem + 0.55vw, 1.7rem);
      font-weight: var(--font-weight-bold);
      letter-spacing: var(--font-tracking-tight);
      line-height: 0.92;
      text-decoration: none;
      transition: transform var(--motion-standard) var(--ease-out);
    }

    .brand-tile:hover {
      color: var(--color-text-primary);
      transform: translateY(-2px);
    }

    .brand-tile span:last-child {
      margin-top: var(--space-2);
    }

    .events-shell {
      grid-template-columns: 14.5rem minmax(0, 1fr);
      grid-template-areas:
        "rail masthead"
        "rail main"
        "rail aside";
    }

    .events-shell .right-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: var(--space-4);
    }
  }

  @media (max-width: 63.99rem) {
    .events-shell .suggest-note {
      display: none;
    }
  }

  @media (min-width: 75rem) {
    .events-shell {
      grid-template-columns: 14.5rem minmax(0, 1fr) 15rem;
      grid-template-areas:
        "rail masthead masthead"
        "rail main aside";
    }

    .events-shell .right-rail {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 0;
    }
  }
</style>
